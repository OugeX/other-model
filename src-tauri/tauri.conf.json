{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Other Model",
  "version": "0.1.0",
  "identifier": "com.othermodel.gateway",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Other Model",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Local multi-provider OpenAI-compatible model gateway",
    "longDescription": "Other Model provides a local OpenAI-compatible gateway, provider pool management, model discovery, health checks, routing controls, and Codex configuration automation.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
